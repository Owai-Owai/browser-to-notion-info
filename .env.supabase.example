# Supabase supplies SUPABASE_URL and server keys inside Edge Functions.
# Do not upload those reserved variables or any database credentials to the extension.
SERVICE_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/notion-sync
PRIVACY_URL=https://YOUR_PUBLIC_SITE/privacy.html
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
ALLOWED_EXTENSION_ID=
PUBLISHER_NAME=
SUPPORT_EMAIL=
# Optional server-side project capture token, never a personal API key.
# Leave unset until the dedicated PostHog project is ready.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
