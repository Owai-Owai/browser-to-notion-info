{
  "name": "browser-to-notion-sync",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "build:public": "tsc --noEmit && vite build --mode public && node scripts/package.mjs dist-public",
    "package:store": "node scripts/package-store.mjs",
    "build:service": "vite build --config vite.service.config.ts",
    "build:supabase": "vite build --config vite.supabase.config.ts",
    "verify:public": "node scripts/verify-public.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build:service && playwright test",
    "service": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "privacy:build": "node --env-file=.env.supabase.local scripts/generate-privacy.mjs",
    "check:supabase": "deno check --config supabase/functions/deno.json supabase/functions/notion-sync/index.ts",
    "test:supabase": "vitest run tests/unit/supabase.test.ts",
    "test:public-package": "node tests/public-package.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "deno": "2.9.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "sharp": "^0.35.5",
    "supabase": "3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.2.7",
    "vitest": "^5.1.1"
  }
}
