# Copy to .env.public.local after deploying the Supabase function and privacy site.
# Public addresses only. Keep Notion and Supabase secrets out of VITE_* variables.
VITE_SERVICE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/notion-sync
VITE_PRIVACY_URL=https://YOUR_PUBLIC_SITE/privacy.html
