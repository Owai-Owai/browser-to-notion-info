{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "types": ["vite/client", "chrome", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "shared", "supabase/functions/_shared", "tests", "vite.config.ts", "vite.service.config.ts", "vite.supabase.config.ts", "playwright.config.ts"]
}
